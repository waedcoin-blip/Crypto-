{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs --log-override:empty-import-meta=silent && esbuild server/workers/tradingWorker.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/worker.cjs --log-override:empty-import-meta=silent",
    "start": "node dist/server.cjs",
    "worker": "node dist/worker.cjs",
    "preview": "vite preview",
    "capture:jupiter": "node scripts/capture-jupiter-fixture.mjs",
    "replay:captured": "node scripts/replay-captured-fixture.mjs",
    "test": "node scripts/final-production-audit.mjs && node scripts/final-production-regression-test.mjs && node scripts/remaining-production-regression.mjs && tsx scripts/refactored-architecture-v90-23-test.mjs && tsx scripts/helius-wss-regression-test.ts",
    "test:jupiter-replay": "node scripts/jupiter-transaction-replay-test.mjs && node scripts/fixture-replay-test.mjs",
    "test:parity": "node scripts/execution-parity-test.mjs",
    "test:tpsl-pipeline": "node scripts/tpsl-evaluation-pipeline-test.mjs",
    "test:tp-sl-raw-balance": "node scripts/tp-sl-raw-balance-regression-test.mjs",
    "test:laserstream": "tsx scripts/laserstream-regression-test.ts",
    "test:helius-wss": "tsx scripts/helius-wss-regression-test.ts",
    "test:single-exit-authority": "node scripts/single-exit-authority-regression-test.mjs",
    "test:jupiter-only": "node scripts/jupiter-only-architecture-test.mjs",
    "test:quote-safety": "tsx scripts/quote-safety-regression-test.ts",
    "test:token-age-gate": "node scripts/token-age-gate-test.mjs",
    "clean": "rm -rf dist",
    "postinstall": "node scripts/patch-bigint-buffer.cjs",
    "lint": "tsc --noEmit",
    "test:integration-audit": "node scripts/integration-audit-v97.mjs",
    "test:integration-audit-v98": "node scripts/integration-audit-v98.mjs",
    "test:rpc-ws-routing": "node scripts/rpc-ws-routing-regression-test.mjs",
    "test:wallet-monitor": "tsx scripts/wallet-transaction-parser-regression-test.ts",
    "test:fami-decimals": "tsx scripts/fami-decimals-regression-test.ts",
    "test:fetch-global": "node scripts/fetch-global-regression-test.mjs"
  },
  "dependencies": {
    "@jup-ag/api": "^6.0.48",
    "@solana/spl-token": "^0.4.14",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-wallets": "^0.19.38",
    "@solana/web3.js": "^1.98.4",
    "@tailwindcss/vite": "^4.1.14",
    "@triton-one/yellowstone-grpc": "^7.0.1",
    "@types/compression": "^1.8.1",
    "@vitejs/plugin-react": "^5.0.4",
    "basic-ftp": "^6.0.1",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "firebase": "^12.12.1",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "mitt": "^3.0.1",
    "motion": "^12.23.24",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.3",
    "whatwg-fetch": "^3.6.20",
    "ws": "^8.21.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
